# Configure logging
log syslog all;

{% if ffi_nat_ip is defined %}
router id {{ ffi_nat_ip | ansible.utils.ipaddr('address') }};
{% else %}
router id {{ vm_id }};
{% endif %}

ipv4 table ffnet4;
ipv6 table ffnet6;


protocol device {
}

protocol bfd {
	vrf "ffnet";
}

protocol direct direct_ffnet {
	vrf "ffnet";
	ipv4 {
		table ffnet4;
	};
	ipv6 {
		table ffnet6;
	};
	interface "ffnet", "bat*", "gre-*", "bck-*";
{% if ffi_tun is defined %}
	interface "tun-ffi*";
{% endif %}
}

protocol kernel kernel_ffnet4 {
	vrf "ffnet";
	ipv4 {
		table ffnet4;
		import all;
		export filter {
			krt_prefsrc = {{ ffi_nat_ip | ansible.utils.ipaddr('address') }};
			accept;
		};
	};
	learn;
	kernel table 1042;
}

protocol kernel kernel_ffnet6 {
	vrf "ffnet";
	ipv6 {
		table ffnet6;
		import all;
		export filter {
			krt_prefsrc = {{ ffi_v6_loopback  | ansible.utils.ipaddr('address')}};
			accept;
		};
	};
	learn;
	kernel table 1042;
}

protocol static static_ffnet4 {
	ipv4 {
		table ffnet4;
	};
{% if ipv4_direkt_ausleiten is defined and ipv4_direkt_ausleiten %}
	route 0.0.0.0/0 via "{{ ansible_default_ipv4.interface }}";
{% endif %}

}

protocol static static_ffnet6 {
	ipv6 {
		table ffnet6;
	};
{% if ffrl_tun is defined or ffi_tun is defined %}
	route {{ff_network.v6_network}} reject;
{% endif %}
}

{% if ffi_tun is defined or (ffi_on_physical_uplink is defined and ffi_on_physical_uplink) %}

#    _____ _____ ___
#   |  ___|  ___|_ _|
#   | |_  | |_   | |
#   |  _| |  _|  | |
#   |_|   |_|   |___|
#
# BEGIN

filter from_ffi {
	# Default Routen ::/0 0.0.0.0/0
	preference = 190;
	if ( net ~ [0.0.0.0/0] || net ~ [::/0]) then accept;
	reject;
};

filter to_ffi {
	# ALLE Host-Routen /32 /128
	# Alle FFNET v6 Routen oder morespecific
	if ( net ~ [0.0.0.0/0{32,32}] || net ~ [::/0{128,128}]) then accept;
	if ( net ~ [::/0{65,127}]) then reject;
	if net ~ [{{ ff_network.v6_network }}+] then accept;
	reject;
};

template bgp uplink_ffi {
	bfd;
	ipv4 {
		next hop self;
		import filter from_ffi;
		export filter to_ffi;
		table ffnet4;
	};
	ipv6 {
		next hop self;
		import filter from_ffi;
		export filter to_ffi;
		table ffnet6;
	};
{% if ff_network.as_number == 209894 %}
	rr client;
{% endif %}
	default bgp_local_pref 200;
};

{% if ffi_tun is defined %}
{% for tun in ffi_tun %}
protocol bgp ffi_{{tun.name|replace('-','_')}}_v4 from uplink_ffi {
	vrf "ffnet";
	local {{ tun.v4_remote | ansible.utils.ipaddr( tun.v4_remote.split('.')[3] | int + 1) | ansible.utils.ipaddr('address') }} as {{ff_network.as_number}};
	neighbor {{ tun.v4_remote | ansible.utils.ipaddr('address') }} as 209894;
{% if "bgp_local_pref" in tun %}
	default bgp_local_pref {{tun.bgp_local_pref}};
{% endif %}
};

protocol bgp ffi_{{tun.name|replace('-','_')}}_v6 from uplink_ffi {
	vrf "ffnet";
	local {{ tun.v6_remote | ansible.utils.next_nth_usable(1) }} as {{ff_network.as_number}};
	neighbor {{tun.v6_remote | ansible.utils.ipaddr('address') }} as 209894;
{% if "bgp_local_pref" in tun %}
	default bgp_local_pref {{tun.bgp_local_pref}};
{% endif %}
};

{% endfor %}
{% endif %}
{% if ffi_on_physical_uplink is defined and ffi_on_physical_uplink %}
protocol bgp ffi_on_uplink_v4 from uplink_ffi {
	local {{ ansible_default_ipv4.address }} as {{ff_network.as_number}};
	neighbor {{ ansible_default_ipv4.gateway }} as 209894;
};

protocol bgp ffi_on_uplink_v6 from uplink_ffi {
	local {{ ansible_default_ipv6.address }} as {{ff_network.as_number}};
	neighbor {{ ansible_default_ipv6.gateway }} as 209894;
};
{% endif %}
# END
{% endif %}

#      _____ _____ _   _ _____ _____
#     |  ___|  ___| \ | | ____|_   _|
#     | |_  | |_  |  \| |  _|   | |
#     |  _| |  _| | |\  | |___  | |
#     |_|   |_|   |_| \_|_____| |_|
#
# BEGIN

filter ospf_ffnet {
        if (source = RTS_DEVICE) || (source = RTS_OSPF) then {
		if ( net ~ [0.0.0.0/0{32,32}] || net ~ [::/0{128,128}]) then accept;
		if ( net ~ [192.168.0.0/16+] || net ~ [2a14:440:1::/48+]) then {
		        if ( net ~ [0.0.0.0/0{31,31}] || net ~ [::/0{127,127}]) then accept;
		}
        }
        reject;
}

protocol ospf v3 {
        vrf "ffnet";
        ipv4 {
		table ffnet4;
		export filter ospf_ffnet;
        };
        area 0.0.0.0 {
		interface "ffnet" {
		        stub yes;
		};
		interface "bck-*";
        };
}

protocol ospf v3 {
        vrf "ffnet";
        ipv6 {
		table ffnet6;
		export filter ospf_ffnet;
        };
        area 0.0.0.0 {
		interface "ffnet" {
		        stub yes;
		};
		interface "bck-*";
        };
}

filter from_intern_ffnet {
	if ( net ~ [0.0.0.0/0] || net ~ [::/0]) then {
		preference = 90;
		accept;
	}
	if net ~ [{{ ff_network.v4_network }}{16,16}] then accept;
	if net ~ [{{ ff_network.v6_network }}{64,64}] then accept;
	reject;
	# Default Routen ::/0 0.0.0.0/0 mit niedriegerer Preferenz
	# Alle FFNET v4 und v6 Routen oder morespecific
};

filter from_intern_ffnet_low_pref {
	if ( net ~ [0.0.0.0/0] || net ~ [::/0]) then {
		preference = 50;
		accept;
	}
	if net ~ [{{ ff_network.v4_network }}{16,16}] then accept;
	if net ~ [{{ ff_network.v6_network }}{64,64}] then accept;
	reject;
	# Default Routen ::/0 0.0.0.0/0 mit noch niedriegerer Preferenz
	# Alle FFNET v4 und v6 Routen oder morespecific
};


filter to_intern_ffnet {
	if ( net ~ [0.0.0.0/0] || net ~ [::/0]) then accept;
	if net ~ [{{ ff_network.v4_network }}{16,16}] then accept;
	if net ~ [{{ ff_network.v6_network }}{64,64}] then accept;
	reject;
	# Default Routen ::/0 0.0.0.0/0 mit niedriegerer Preferenz
	# Alle FFNET v4 und v6 Routen oder morespecific
};

template bgp internal_ffnet {
	vrf "ffnet";
	local as {{ff_network.as_number}};
	ipv4 {
		next hop self;
		import filter from_intern_ffnet;
		export filter to_intern_ffnet;
		table ffnet4;
	};
	ipv6 {
		next hop self;
		import filter from_intern_ffnet;
		export filter to_intern_ffnet;
		table ffnet6;
	};
};

{% for host in groups['gateways']|default([]) %}
{% if hostvars[host].vm_id != vm_id %}
protocol bgp ibgp_{{host|regex_replace('-','_')}}_v4 from internal_ffnet {
{% if hostvars[host].ffi_nat_ip is defined %}
	neighbor {{ hostvars[host].ffi_nat_ip | ansible.utils.ipaddr('address') }} as {{ff_network.as_number}};
{% else %}
{% if hostvars[host].vm_id < vm_id %}
	neighbor 192.168.{{ hostvars[host].vm_id-1 }}.{{vm_id*2}} as {{ff_network.as_number}};
{% else %}
	neighbor 192.168.{{ vm_id-1 }}.{{hostvars[host].vm_id*2+1}} as {{ff_network.as_number}};
{% endif %}
{% endif %}
{% if hostvars[host].hoster|default('unknown') != hoster|default('unknown') %}
	ipv4 {
		import filter from_intern_ffnet_low_pref;
	};
{% endif %}
}

protocol bgp ibgp_{{host|regex_replace('-','_')}}_v6 from internal_ffnet {
{% if hostvars[host].ffi_v6_loopback is defined %}
	neighbor {{ hostvars[host].ffi_v6_loopback  | ansible.utils.ipaddr('address')}} as {{ff_network.as_number}};
{% else %}
{% if hostvars[host].vm_id < vm_id %}
	neighbor {{ipv6backbone64prefixstr}}{{hostvars[host].vm_id}}:{{vm_id}}:1 as {{ff_network.as_number}};
{% else %}
	neighbor {{ipv6backbone64prefixstr}}{{vm_id}}:{{hostvars[host].vm_id}}:0 as {{ff_network.as_number}};
{% endif %}
{% endif %}
{% if hostvars[host].hoster|default('unknown') != hoster|default('unknown') %}
	ipv6 {
		import filter from_intern_ffnet_low_pref;
	};
{% endif %}
}

{% endif %}
{% endfor %}

# END

{% if domaenenliste is defined %}
#      ____     _    ____
#     |  _ \   / \  |  _ \__   __
#     | |_) | / _ \ | | | \ \ / /
#     |  _ < / ___ \| |_| |\ V /
#     |_| \_/_/   \_|____/  \_/
#
# BEGIN
protocol radv {
	vrf "ffnet";
	ipv6 {
		table ffnet6;
	};
{% for domaene in domaenenliste|dictsort %}
	interface "bat{{domaene[0]}}" {
		max ra interval 20;
		link mtu 1280;
		rdnss {{domaenen[domaene[0]].ffv6_ffi_network | ipaddr(domaene[1].server_id) | ipaddr('address') }};
		route preference high;
		prefix {{domaenen[domaene[0]].ffv6_ffrl_network}} {
			preferred lifetime 0;
		};
		prefix {{domaenen[domaene[0]].ffv6_ffi_network}} {
		};
	};
{% endfor %}
}
# END
{% endif %}

