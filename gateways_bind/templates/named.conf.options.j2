// {{ ansible_managed }}

options {
	directory "/var/cache/bind";

	dnssec-validation auto;

	recursion yes;
	allow-recursion {
		localhost; 
{% if domaenenliste is defined %}
{% for domaene in domaenenliste|dictsort %}
		{{domaenen[domaene[0]].ffv4_network}};
{% if domaenen[domaene[0]].ffv6_ffrl_network is defined %}
		{{domaenen[domaene[0]].ffv6_ffrl_network}};
{% endif %}
{% if domaenen[domaene[0]].ffv6_ffi_network is defined %}
		{{domaenen[domaene[0]].ffv6_ffi_network}};
{% endif %}
{% endfor %}
{% endif %}
	};

	auth-nxdomain no;    # conform to RFC1035
	listen-on-v6 { any; };
	minimal-responses yes;
	tcp-clients 1000;
	recursive-clients 10000;
	rrset-order { order random; };
};
{% if collectd is defined and collectd.collect_bind %}
statistics-channels {
	inet 127.0.0.1 port 8053 allow { 127.0.0.1; };
};
{% endif %}
